<?xml version="1.0" encoding="UTF-8"?>
<coverage>
    <include>
        <directory suffix=".php">.</directory>
    </include>
    <exclude>
        <directory>vendor</directory>
        <directory>tests</directory>
        <directory>images</directory>
        <directory>postimages</directory>
        <file>composer.json</file>
        <file>composer.lock</file>
        <file>Dockerfile</file>
        <file>docker-compose.yml</file>
        <file>.dockerignore</file>
        <file>.gitignore</file>
    </exclude>
    <report>
        <html outputDirectory="coverage/html" />
        <clover outputFile="coverage/clover.xml" />
        <text outputFile="coverage/coverage.txt" />
    </report>
    <logging>
        <log type="coverage-html" target="coverage/html" lowUpperBound="35" highLowerBound="70" />
        <log type="coverage-clover" target="coverage/clover.xml" />
        <log type="coverage-text" target="coverage/coverage.txt" />
    </logging>
</coverage> 